# Ejercicio 6: Clasificar el IMC
peso_persona = float(input("Escribe tu peso en kilogramos: "))
estatura = float(input("Escribe tu estatura en metros: "))
imc = peso_persona / estatura ** 2

if imc < 18.5:
    categoria_imc = "bajo peso"
elif imc < 25:
    categoria_imc = "normal"
elif imc < 30:
    categoria_imc = "sobrepeso"
else:
    categoria_imc = "obesidad"

print(f"Tu IMC es {imc:.2f}: {categoria_imc}.")

# Ejercicio 7: Tarifas de electricidad
consumo = float(input("Escribe el consumo mensual en kWh: "))

if consumo <= 150:
    costo_electricidad = consumo * 1.20
elif consumo <= 300:
    costo_electricidad = 150 * 1.20 + (consumo - 150) * 1.80
else:
    costo_electricidad = 150 * 1.20 + 150 * 1.80 + (consumo - 300) * 2.50

print(f"Consumo: {consumo:g} kWh. Costo total: ${costo_electricidad:.1f}.")
