# Ejercicio 2
cuadernos = "4"
plumas = "9"

print(cuadernos + plumas)
print(int(cuadernos) + int(plumas))
# Al sumar texto con +, se concatenan los caracteres ("49"); al convertir con int(), se realiza una suma numérica (13).

bocinas = "42"
tabletas = "18"

print(bocinas + tabletas)
print(int(bocinas) + int(tabletas))
# Con + como texto se juntan ("4218"), mientras que con int() se suman sus valores numéricos (60).

