    function sonarOwTriste() {
      if (ctxAudio.state === "suspended") ctxAudio.resume();
      const inicio = ctxAudio.currentTime;
      const duracion = 0.55;
      const voz = ctxAudio.createOscillator();
      const filtro = ctxAudio.createBiquadFilter();
      const volumen = ctxAudio.createGain();
      voz.type = "sawtooth";
      voz.frequency.setValueAtTime(420, inicio);
      voz.frequency.exponentialRampToValueAtTime(210, inicio + 0.48);
      filtro.type = "lowpass";
      filtro.frequency.setValueAtTime(1100, inicio);
      filtro.frequency.exponentialRampToValueAtTime(520, inicio + 0.48);
      volumen.gain.setValueAtTime(0.001, inicio);
      volumen.gain.exponentialRampToValueAtTime(0.075, inicio + 0.035);
      volumen.gain.setValueAtTime(0.045, inicio + 0.2);
      volumen.gain.exponentialRampToValueAtTime(0.001, inicio + duracion);
      voz.connect(filtro);
      filtro.connect(volumen);
      volumen.connect(ctxAudio.destination);
      voz.start(inicio);
      voz.stop(inicio + duracion);
    }

    function sonarMaullido() {
      if (ctxAudio.state === "suspended") ctxAudio.resume();
      const inicio = ctxAudio.currentTime;
      const duracion = 0.72;
      const voz = ctxAudio.createOscillator();
      const formanteAbierto = ctxAudio.createBiquadFilter();
      const formanteCerrado = ctxAudio.createBiquadFilter();
      const volumenAbierto = ctxAudio.createGain();
      const volumenCerrado = ctxAudio.createGain();
      const vibrato = ctxAudio.createOscillator();
      const profundidadVibrato = ctxAudio.createGain();
      const envolvente = ctxAudio.createGain();

      voz.type = "sawtooth";
      voz.frequency.setValueAtTime(460, inicio);
      voz.frequency.linearRampToValueAtTime(760, inicio + 0.18);
      voz.frequency.exponentialRampToValueAtTime(330, inicio + 0.65);
      formanteAbierto.type = "bandpass";
      formanteAbierto.Q.setValueAtTime(1.2, inicio);
      formanteAbierto.frequency.setValueAtTime(400, inicio);
      formanteAbierto.frequency.linearRampToValueAtTime(850, inicio + 0.18);
      formanteAbierto.frequency.linearRampToValueAtTime(430, inicio + 0.65);
      formanteCerrado.type = "bandpass";
      formanteCerrado.Q.setValueAtTime(1.4, inicio);
      formanteCerrado.frequency.setValueAtTime(2400, inicio);
      formanteCerrado.frequency.linearRampToValueAtTime(1450, inicio + 0.18);
      formanteCerrado.frequency.linearRampToValueAtTime(900, inicio + 0.65);
      volumenAbierto.gain.setValueAtTime(0.7, inicio);
      volumenCerrado.gain.setValueAtTime(0.35, inicio);
      vibrato.frequency.setValueAtTime(5.5, inicio);
      profundidadVibrato.gain.setValueAtTime(14, inicio);
      vibrato.connect(profundidadVibrato);
      profundidadVibrato.connect(voz.frequency);
      envolvente.gain.setValueAtTime(0.001, inicio);
      envolvente.gain.exponentialRampToValueAtTime(0.08, inicio + 0.05);
      envolvente.gain.setValueAtTime(0.06, inicio + 0.48);
      envolvente.gain.exponentialRampToValueAtTime(0.001, inicio + duracion);

      voz.connect(formanteAbierto);
      formanteAbierto.connect(volumenAbierto);
      volumenAbierto.connect(envolvente);
      voz.connect(formanteCerrado);
      formanteCerrado.connect(volumenCerrado);
      volumenCerrado.connect(envolvente);
      envolvente.connect(ctxAudio.destination);
      voz.start(inicio);
      vibrato.start(inicio);
      voz.stop(inicio + duracion);
      vibrato.stop(inicio + duracion);
    }

    function sonarSquishSlime() {
      const inicio = ctxAudio.currentTime;
      const duracion = 1.1;
      const muestras = Math.floor(ctxAudio.sampleRate * duracion);
      const buffer = ctxAudio.createBuffer(1, muestras, ctxAudio.sampleRate);
      const ruidoDatos = buffer.getChannelData(0);

      for (let i = 0; i < muestras; i++) {
        ruidoDatos[i] = Math.random() * 2 - 1;
      }

      const ruido = ctxAudio.createBufferSource();
      const filtroLiquido = ctxAudio.createBiquadFilter();
      const volumenRuido = ctxAudio.createGain();
      const squish = ctxAudio.createOscillator();
      const filtroSquish = ctxAudio.createBiquadFilter();
      const volumenSquish = ctxAudio.createGain();

      filtroLiquido.type = "lowpass";
      filtroLiquido.frequency.setValueAtTime(1200, inicio);
      filtroLiquido.frequency.exponentialRampToValueAtTime(520, inicio + 0.35);
      filtroLiquido.frequency.exponentialRampToValueAtTime(1050, inicio + 0.72);
      filtroLiquido.frequency.exponentialRampToValueAtTime(480, inicio + duracion);
      filtroLiquido.Q.setValueAtTime(1.2, inicio);
      volumenRuido.gain.setValueAtTime(0.001, inicio);
      volumenRuido.gain.exponentialRampToValueAtTime(0.06, inicio + 0.12);
      volumenRuido.gain.exponentialRampToValueAtTime(0.018, inicio + 0.36);
      volumenRuido.gain.exponentialRampToValueAtTime(0.065, inicio + 0.68);
      volumenRuido.gain.exponentialRampToValueAtTime(0.001, inicio + duracion);

      ruido.buffer = buffer;
      ruido.connect(filtroLiquido);
      filtroLiquido.connect(volumenRuido);
      volumenRuido.connect(salidaSonidoSlime);

      squish.type = "triangle";
      squish.frequency.setValueAtTime(160, inicio);
      squish.frequency.exponentialRampToValueAtTime(270, inicio + 0.22);
      squish.frequency.exponentialRampToValueAtTime(125, inicio + 0.58);
      squish.frequency.exponentialRampToValueAtTime(205, inicio + 0.82);
      squish.frequency.exponentialRampToValueAtTime(110, inicio + duracion);
      filtroSquish.type = "lowpass";
      filtroSquish.frequency.setValueAtTime(620, inicio);
      filtroSquish.Q.setValueAtTime(1.8, inicio);
      volumenSquish.gain.setValueAtTime(0.001, inicio);
      volumenSquish.gain.exponentialRampToValueAtTime(0.045, inicio + 0.1);
      volumenSquish.gain.exponentialRampToValueAtTime(0.001, inicio + duracion);
      squish.connect(filtroSquish);
      filtroSquish.connect(volumenSquish);
      volumenSquish.connect(salidaSonidoSlime);

      ruido.start(inicio);
      ruido.stop(inicio + duracion);
      squish.start(inicio);
      squish.stop(inicio + duracion);
    }

    function congelarVideoSlime(video) {
      if (videoSlimeActivo === video) return;
      if (!video.complete || video.naturalWidth === 0) {
        video.addEventListener("load", () => congelarVideoSlime(video), { once: true });
        return;
      }

      const fotograma = document.createElement("canvas");
      fotograma.width = video.naturalWidth;
      fotograma.height = video.naturalHeight;
      const contexto = fotograma.getContext("2d");
      if (!contexto) {
        console.error("No se pudo congelar el fotograma de slime.");
        return;
      }

      contexto.drawImage(video, 0, 0);
      video.src = fotograma.toDataURL("image/png");
    }

    async function reproducirVideoSlime(video) {
      if (videoSlimeActivo === video) return;
      if (videoSlimeActivo) pausarVideoSlime(videoSlimeActivo);
      videoSlimeActivo = video;
      video.src = fuentesGifSlime.get(video);

      try {
        if (video === videosSlimeEls[0]) {
          await audioCrunchySlime.play();
          if (videoSlimeActivo !== video) {
            audioCrunchySlime.pause();
            audioCrunchySlime.currentTime = 0;
          }
          return;
        }

        await ctxAudio.resume();
        if (videoSlimeActivo !== video) return;
        const ahora = ctxAudio.currentTime;
        salidaSonidoSlime.gain.cancelScheduledValues(ahora);
        salidaSonidoSlime.gain.setTargetAtTime(3, ahora, 0.025);
        sonarSquishSlime();
        intervaloSonidoSlime = setInterval(sonarSquishSlime, 1300);
      } catch (error) {
        console.error("No se pudo reproducir el sonido del slime:", error);
      }
    }

    function pausarVideoSlime(video) {
      if (videoSlimeActivo !== video) return;
      videoSlimeActivo = null;
      if (intervaloSonidoSlime !== null) {
        clearInterval(intervaloSonidoSlime);
        intervaloSonidoSlime = null;
      }
      if (video === videosSlimeEls[0]) {
        audioCrunchySlime.pause();
        audioCrunchySlime.currentTime = 0;
      } else {
        const ahora = ctxAudio.currentTime;
        salidaSonidoSlime.gain.cancelScheduledValues(ahora);
        salidaSonidoSlime.gain.setTargetAtTime(0, ahora, 0.025);
      }
      congelarVideoSlime(video);
    }

    videosSlimeEls.forEach(video => {
      video.addEventListener("mouseenter", () => reproducirVideoSlime(video));
      video.addEventListener("mouseleave", () => pausarVideoSlime(video));
      congelarVideoSlime(video);
    });

