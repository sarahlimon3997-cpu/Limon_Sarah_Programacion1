<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gato Gatete</title>
  <link rel="icon" href="icon.jpg" />
  <style>
    @font-face {
      font-family: 'ButtonsPatches';
      src: url('fuente.ttf');
    }

    :root {
      --rosa-1: #FFA2B9;
      --rosa-2: #FFB2C5;
      --rosa-3: #FFC2D1;
      --rosa-4: #FDD5DF;
      --rosa-5: #FAE8ED;
      --texto: #5A2A3A;
    }

    * {
      box-sizing: border-box;
      user-select: none;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: 'ButtonsPatches', sans-serif;
      color: var(--texto);
      background: var(--rosa-5) url("corazones.gif") repeat;
      padding: 24px 20px 110px;
    }

    .contenedor {
      max-width: 1120px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      padding-top: 170px;
    }

    .tarjeta {
      background: rgba(250, 232, 237, 0.94);
      border: 3px solid var(--rosa-1);
      border-radius: 24px;
      padding: 20px;
      box-shadow: 0 8px 20px rgba(255, 162, 185, 0.35);
    }

    h1, h2 {
      margin: 0 0 12px;
      text-align: center;
      letter-spacing: 1px;
    }

    .subtitulo {
      margin: 0 0 12px;
      text-align: center;
    }

    .controles {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin-bottom: 14px;
    }

    button, select {
      font-family: 'ButtonsPatches', sans-serif;
      background: var(--rosa-3);
      color: var(--texto);
      border: 2px solid var(--rosa-1);
      border-radius: 14px;
      padding: 8px 14px;
      font-size: 16px;
      cursor: pointer;
    }

    button:hover {
      background: var(--rosa-2);
    }

    .marcador {
      display: flex;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
      margin-bottom: 12px;
      font-size: 16px;
    }

    .estado {
      text-align: center;
      font-size: 18px;
      margin-bottom: 12px;
    }

    .reproductor-barra {
      margin: 12px 0 14px;
    }

    .pista-rastro {
      position: relative;
      height: 10px;
      background: var(--rosa-4);
      border: 2px solid var(--rosa-1);
      border-radius: 999px;
      cursor: pointer;
      margin: 14px 0 8px;
    }

    .pista-relleno {
      height: 100%;
      width: 0%;
      background: var(--rosa-2);
      border-radius: 999px;
    }

    .corazon-avance {
      position: absolute;
      top: 50%;
      left: 0%;
      transform: translate(-50%, -52%);
      width: 22px;
      height: 20px;
      pointer-events: none;
      transition: left 0.08s linear;
    }

    .corazon-avance svg {
      width: 100%;
      height: 100%;
      fill: #FFA2B9;
      stroke: #5A2A3A;
      stroke-width: 1.5;
      display: block;
    }

    .tiempos-pista {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      opacity: 0.9;
    }

    .controles-player {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-bottom: 10px;
    }

    .panel-playlist {
      position: fixed;
      top: 16px;
      right: 16px;
      z-index: 30;
      background: rgba(250, 232, 237, 0.96);
      border: 3px solid var(--rosa-1);
      border-radius: 20px;
      padding: 8px 10px;
      box-shadow: 0 8px 20px rgba(255, 162, 185, 0.35);
      width: 300px;
      max-width: calc(100vw - 32px);
      max-height: calc(100vh - 32px);
      overflow-y: auto;
    }

    .panel-playlist h2 {
      font-size: 13.5px;
      margin: 0 0 6px;
      text-align: left;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .panel-playlist .reproductor-barra {
      margin: 4px 0 6px;
    }

    .panel-playlist .pista-rastro {
      height: 8px;
      margin: 8px 0 4px;
    }

    .panel-playlist .corazon-avance {
      width: 18px;
      height: 16px;
    }

    .panel-playlist .controles-player {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 4px;
    }

    .panel-playlist .controles-player button {
      padding: 3px 8px;
      font-size: 12px;
      border-radius: 10px;
    }

    .panel-playlist .tiempos-pista {
      font-size: 11px;
      gap: 10px;
      justify-content: flex-start;
    }

    .panel-playlist .lista-canciones {
      display: flex;
      flex-direction: row;
      gap: 5px;
      overflow-x: auto;
      margin-top: 6px;
      padding-bottom: 2px;
    }

    .panel-playlist .item-cancion {
      flex: 0 0 auto;
      width: auto;
      max-width: 92px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-align: center;
      background: var(--rosa-4);
      padding: 4px 7px;
      font-size: 11px;
      border-radius: 10px;
    }

    .panel-playlist .item-cancion.activa,
    #btn-loop-playlist.activa {
      background: var(--rosa-1);
    }

    .tablero-gato {
      display: grid;
      grid-template-columns: repeat(3, 88px);
      gap: 10px;
      justify-content: center;
      margin: 0 auto;
    }

    .celda-gato {
      width: 88px;
      height: 88px;
      background: var(--rosa-4);
      border: 2px solid var(--rosa-1);
      border-radius: 18px;
      font-size: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .tablero-4 {
      display: grid;
      grid-template-columns: repeat(7, 52px);
      gap: 8px;
      justify-content: center;
      margin: 0 auto;
    }

    .celda-4 {
      width: 52px;
      height: 52px;
      background: var(--rosa-4);
      border: 2px solid var(--rosa-1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .celda-4 img {
      width: 34px;
      height: 34px;
      object-fit: contain;
      pointer-events: none;
    }

    .burbujas {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }

    .burbuja {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #ffffff, var(--rosa-3) 65%, var(--rosa-1));
      border: 2px solid var(--rosa-1);
      cursor: pointer;
      transition: transform 0.15s ease, opacity 0.2s ease;
    }

    .seccion-slime {
      max-width: 780px;
      margin: 24px auto;
      text-align: center;
    }

    .seccion-slime h2 {
      margin: 0 0 18px;
      text-align: center;
      font-size: 26px;
    }

    .seccion-slime > h2:nth-of-type(2) {
      margin-top: 24px;
    }

    .fila-slime {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }

    .item-slime {
      display: block;
      width: 280px;
      max-width: 100%;
      aspect-ratio: 1;
      height: auto;
      border-radius: 18px;
      overflow: hidden;
      border: 3px solid var(--rosa-1);
      background: var(--rosa-4);
      cursor: pointer;
      object-fit: cover;
    }

    .item-slime.video-slime {
      margin: 0;
    }

    .burbuja.explotada {
      opacity: 0.25;
      transform: scale(0.85);
    }

    .dato-caja {
      text-align: center;
      background: var(--rosa-4);
      border-radius: 16px;
      padding: 14px;
      margin-bottom: 12px;
      font-size: 17px;
    }

    .cierre-final {
      max-width: 960px;
      margin: 36px auto 24px;
      padding: 8px 16px;
      text-align: center;
    }

    .cierre-final img {
      display: block;
      margin: 0 auto 10px;
      max-width: 140px;
      height: auto;
    }

    .cierre-final p {
      margin: 0;
      font-size: 16px;
      color: var(--texto);
    }

    @media (max-width: 500px) {
      .tablero-4 {
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 4px;
        width: 100%;
      }

      .celda-4 {
        width: 100%;
        height: auto;
        aspect-ratio: 1;
      }

      .celda-4 img {
        width: 80%;
        height: 80%;
      }
    }

    .gato-esquina {
      position: fixed;
      right: 16px;
      bottom: 16px;
      width: 86px;
      height: auto;
      z-index: 20;
      pointer-events: none;
    }

    .gato-blanco-esquina {
      position: fixed;
      left: 16px;
      bottom: 16px;
      width: 100px;
      height: auto;
      z-index: 20;
      pointer-events: none;
    }

    .gata-esquina {
      position: fixed;
      top: 16px;
      left: 16px;
      width: 86px;
      height: auto;
      z-index: 20;
      pointer-events: none;
    }

    @media (max-width: 500px) {
      .panel-playlist {
        width: calc(100vw - 100px);
        max-width: calc(100vw - 100px);
      }

      .gata-esquina {
        top: 20px;
        left: 12px;
        width: 56px;
      }

      .gato-blanco-esquina {
        left: 12px;
        bottom: 12px;
        width: 64px;
      }
    }

  </style>
</head>
<body>
  <div class="contenedor">
    <section class="tarjeta">
      <h1>Gato Gatete</h1>
      <p class="subtitulo">Rinconsito gatuno para dejar por un momento el scroll :3</p>
      <div class="controles">
        <label>
          Dificultad:
          <select id="dificultad">
            <option value="facil">cachorros</option>
            <option value="medio">gato</option>
            <option value="imposible">gatote</option>
          </select>
        </label>
        <button id="btn-reiniciar-todo">Reiniciar marcadores</button>
      </div>
    </section>

    <aside class="panel-playlist">
      <h2 id="titulo-cancion-actual">Le ciel ~ Kuuhaku no Kanata e ~/MALICE MIZER [Music Box]</h2>

      <div class="controles-player">
        <button id="btn-prev-pista" title="Cancion anterior">|&lt;</button>
        <button id="btn-play-pausa" title="Reproducir o pausar">&gt;</button>
        <button id="btn-sig-pista" title="Siguiente cancion">&gt;|</button>
        <button id="btn-loop-playlist" class="activa" title="Repetir playlist en loop">Loop</button>
      </div>
    <section class="tarjeta">
      <h2>Gato (Tic-Tac-Toe)</h2>
      <div class="marcador">
        <span>Jugador (X): <strong id="score-gato-tu">0</strong></span>
        <span>Empates: <strong id="score-gato-empate">0</strong></span>
        <span>Gato PC (O): <strong id="score-gato-pc">0</strong></span>
      </div>
      <div class="estado" id="estado-gato">Turno del jugador (X)</div>
      <div class="tablero-gato" id="tablero-gato"></div>
      <div class="controles" style="margin-top: 14px;">
        <button id="btn-nueva-gato">Nueva partida de Gato</button>
      </div>
    </section>

    <section class="tarjeta">
      <h2>Linea de 4</h2>
      <div class="marcador">
        <span>Jugador (1): <strong id="score-4-tu">0</strong></span>
        <span>Empates: <strong id="score-4-empate">0</strong></span>
        <span>Gato PC (2): <strong id="score-4-pc">0</strong></span>
      </div>
      <div class="estado" id="estado-4">Turno del jugador (1)</div>
      <div class="tablero-4" id="tablero-4"></div>
      <div class="controles" style="margin-top: 14px;">
        <button id="btn-nueva-4">Nueva partida de Linea de 4</button>
      </div>
    </section>

    <section class="tarjeta">
      <h2>Datos curiosos de gatos</h2>
      <div class="dato-caja" id="dato-gato"></div>
      <div class="controles">
        <button id="btn-dato">Otro dato gatuno</button>
      </div>
    </section>

  <script>
    const dificultadEl = document.getElementById("dificultad");

    // --- GATO ---
    const tableroGatoEl = document.getElementById("tablero-gato");
    const estadoGatoEl = document.getElementById("estado-gato");
    let tableroGato = Array(9).fill("");
    let turnoGato = "TU";
    let finGato = false;
    let scoreGato = { tu: 0, pc: 0, empate: 0 };

    const lineasGato = [
      [0, 1, 2], [3, 4, 5], [6, 7, 8],
      [0, 3, 6], [1, 4, 7], [2, 5, 8],
      [0, 4, 8], [2, 4, 6]
    ];

    function revisarGanadorGato(board) {
      for (const [a, b, c] of lineasGato) {
        if (board[a] && board[a] === board[b] && board[a] === board[c]) {
          return board[a];
        }
      }
      if (!board.includes("")) return "EMPATE";
      return null;
    }

    function minimaxGato(board, esTurnoPc) {
      const res = revisarGanadorGato(board);
      if (res === "PC") return 10;
      if (res === "TU") return -10;
      if (res === "EMPATE") return 0;

      if (esTurnoPc) {
        let mejor = -Infinity;
        for (let i = 0; i < 9; i++) {
          if (!board[i]) {
            board[i] = "PC";
            mejor = Math.max(mejor, minimaxGato(board, false));
            board[i] = "";
          }
        }
        return mejor;
      } else {
        let peor = Infinity;
        for (let i = 0; i < 9; i++) {
          if (!board[i]) {
            board[i] = "TU";
            peor = Math.min(peor, minimaxGato(board, true));
            board[i] = "";
          }
        }
        return peor;
      }
    }

    function movimientoPcGato() {
      if (finGato) return;
      const libres = tableroGato.map((v, i) => v === "" ? i : -1).filter(i => i !== -1);
      if (!libres.length) return;

      let elegido;
      if (dificultadEl.value === "facil") {
        elegido = libres[Math.floor(Math.random() * libres.length)];
      } else if (dificultadEl.value === "medio") {
        elegido = libres.find(idx => {
          tableroGato[idx] = "PC";
          const gana = revisarGanadorGato(tableroGato) === "PC";
          tableroGato[idx] = "";
          return gana;
        });
        if (elegido === undefined) {
          const amenaza = libres.find(idx => {
            tableroGato[idx] = "TU";
            const gana = revisarGanadorGato(tableroGato) === "TU";
            tableroGato[idx] = "";
            return gana;
          });
          elegido = amenaza !== undefined && Math.random() < 0.8
            ? amenaza
            : libres[Math.floor(Math.random() * libres.length)];
        }
      } else {
        let mejorPuntaje = -Infinity;
        elegido = libres[0];
        for (const idx of libres) {
          tableroGato[idx] = "PC";
          const puntaje = minimaxGato(tableroGato, false);
          tableroGato[idx] = "";
          if (puntaje > mejorPuntaje) {
            mejorPuntaje = puntaje;
            elegido = idx;
          }
        }
      }

      tableroGato[elegido] = "PC";
      renderGato();
      const ganador = revisarGanadorGato(tableroGato);
      if (ganador) {
        terminarGato(ganador);
      } else {
        turnoGato = "TU";
        estadoGatoEl.textContent = "Turno del jugador (X)";
      }
    }

    function terminarGato(ganador) {
      finGato = true;
      if (ganador === "TU") {
        scoreGato.tu++;
        estadoGatoEl.textContent = "Ganaste!";
        sonarConfeti();
      } else if (ganador === "PC") {
        scoreGato.pc++;
        estadoGatoEl.textContent = "Gano Gato PC";
        sonarOwTriste();
      } else {
        scoreGato.empate++;
        estadoGatoEl.textContent = "Empate!";
        sonarMaullido();
      }
      actualizarMarcadores();
    }

    function renderGato() {
      tableroGatoEl.innerHTML = "";
      tableroGato.forEach((val, idx) => {
        const btn = document.createElement("button");
        btn.className = "celda-gato";
        btn.textContent = val === "TU" ? "X" : val === "PC" ? "O" : "";
        btn.onclick = () => {
          if (finGato || turnoGato !== "TU" || tableroGato[idx]) return;
          tableroGato[idx] = "TU";
          sonarPop();
          renderGato();
          const ganador = revisarGanadorGato(tableroGato);
          if (ganador) {
            terminarGato(ganador);
            return;
          }
          turnoGato = "PC";
          estadoGatoEl.textContent = "Gato PC pensando...";
          setTimeout(movimientoPcGato, 280);
        };
        tableroGatoEl.appendChild(btn);
      });
    }

    function nuevaGato() {
      tableroGato = Array(9).fill("");
      turnoGato = "TU";
      finGato = false;
      estadoGatoEl.textContent = "Turno del jugador (X)";
      renderGato();
    }

    // --- LINEA DE 4 ---
    const FILAS = 6;
    const COLS = 7;
    const tablero4El = document.getElementById("tablero-4");
    const estado4El = document.getElementById("estado-4");
    let grid4 = Array.from({ length: FILAS }, () => Array(COLS).fill(""));
    let turno4 = "TU";
    let fin4 = false;
    let score4 = { tu: 0, pc: 0, empate: 0 };

    function filaDisponible(board, col) {
      for (let r = FILAS - 1; r >= 0; r--) {
        if (!board[r][col]) return r;
      }
      return -1;
    }

    function revisarGanador4(board) {
      const dirs = [[0, 1], [1, 0], [1, 1], [1, -1]];
      for (let r = 0; r < FILAS; r++) {
        for (let c = 0; c < COLS; c++) {
          const jugador = board[r][c];
          if (!jugador) continue;
          for (const [dr, dc] of dirs) {
            let count = 1;
            for (let k = 1; k < 4; k++) {
              const nr = r + dr * k;
              const nc = c + dc * k;
              if (nr < 0 || nr >= FILAS || nc < 0 || nc >= COLS || board[nr][nc] !== jugador) break;
              count++;
            }
            if (count === 4) return jugador;
          }
        }
      }
      if (board.every(fila => fila.every(celda => celda !== ""))) return "EMPATE";
      return null;
    }

    function evaluarVentana(ventana) {
      const pc = ventana.filter(v => v === "PC").length;
      const tu = ventana.filter(v => v === "TU").length;
      if (pc === 4) return 1000;
      if (tu === 4) return -1000;
      if (pc === 3 && tu === 0) return 12;
      if (pc === 2 && tu === 0) return 3;
      if (tu === 3 && pc === 0) return -15;
      return 0;
    }

    function puntuarTablero4(board) {
      let score = 0;
      const centro = Math.floor(COLS / 2);
      for (let r = 0; r < FILAS; r++) {
        if (board[r][centro] === "PC") score += 6;
      }
      for (let r = 0; r < FILAS; r++) {
        for (let c = 0; c <= COLS - 4; c++) {
          score += evaluarVentana([board[r][c], board[r][c+1], board[r][c+2], board[r][c+3]]);
        }
      }
      for (let c = 0; c < COLS; c++) {
        for (let r = 0; r <= FILAS - 4; r++) {
          score += evaluarVentana([board[r][c], board[r+1][c], board[r+2][c], board[r+3][c]]);
        }
      }
      for (let r = 0; r <= FILAS - 4; r++) {
        for (let c = 0; c <= COLS - 4; c++) {
          score += evaluarVentana([board[r][c], board[r+1][c+1], board[r+2][c+2], board[r+3][c+3]]);
        }
      }
      for (let r = 3; r < FILAS; r++) {
        for (let c = 0; c <= COLS - 4; c++) {
          score += evaluarVentana([board[r][c], board[r-1][c+1], board[r-2][c+2], board[r-3][c+3]]);
        }
      }
      return score;
    }

    function minimax4(board, profundidad, esPc) {
      const ganador = revisarGanador4(board);
      if (ganador === "PC") return 100000 + profundidad;
      if (ganador === "TU") return -100000 - profundidad;
      if (ganador === "EMPATE" || profundidad === 0) return puntuarTablero4(board);

      const colsValidas = [];
      for (let c = 0; c < COLS; c++) {
        if (filaDisponible(board, c) !== -1) colsValidas.push(c);
      }

      if (esPc) {
        let val = -Infinity;
        for (const c of colsValidas) {
          const r = filaDisponible(board, c);
          board[r][c] = "PC";
          val = Math.max(val, minimax4(board, profundidad - 1, false));
          board[r][c] = "";
        }
        return val;
      } else {
        let val = Infinity;
        for (const c of colsValidas) {
          const r = filaDisponible(board, c);
          board[r][c] = "TU";
          val = Math.min(val, minimax4(board, profundidad - 1, true));
          board[r][c] = "";
        }
        return val;
      }
    }

    function movimientoPc4() {
      if (fin4) return;
      const validas = [];
      for (let c = 0; c < COLS; c++) {
        if (filaDisponible(grid4, c) !== -1) validas.push(c);
      }
      if (!validas.length) return;

      let colElegida;
      if (dificultadEl.value === "facil") {
        colElegida = validas[Math.floor(Math.random() * validas.length)];
      } else {
        let mejorVal = -Infinity;
        colElegida = validas[0];
        const profundidad = dificultadEl.value === "medio" ? 1 : 4;
        for (const c of validas) {
          const r = filaDisponible(grid4, c);
          grid4[r][c] = "PC";
          const val = minimax4(grid4, profundidad, false);
          grid4[r][c] = "";
          if (val > mejorVal) {
            mejorVal = val;
            colElegida = c;
          }
        }
      }

      const fila = filaDisponible(grid4, colElegida);
