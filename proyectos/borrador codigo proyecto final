    function mostrarErrorPista(error) {
      tituloCancionEl.textContent = "No se pudo reproducir esta pista.";
      btnPlayPausa.textContent = ">";
      console.error("Error al reproducir la pista:", error);
    }

    function reproducirPista(idx) {
      pistaActual = (idx + cancionesKawaii.length) % cancionesKawaii.length;
      audioPlaylist.src = cancionesKawaii[pistaActual].archivo;
      audioPlaylist.currentTime = 0;
      actualizarBarraCorazon();
      audioPlaylist.play().catch(mostrarErrorPista);
      tituloCancionEl.textContent = cancionesKawaii[pistaActual].titulo;
      tituloCancionEl.title = cancionesKawaii[pistaActual].titulo;
      btnPlayPausa.textContent = "II";
      pintarPlaylist();
    }

    btnPrevPista.onclick = () => reproducirPista(pistaActual - 1);
    btnLoopPlaylist.onclick = () => {
      loopPlaylist = !loopPlaylist;
      btnLoopPlaylist.classList.toggle("activa", loopPlaylist);
      btnLoopPlaylist.setAttribute("aria-pressed", loopPlaylist);
    };

    btnPlayPausa.onclick = () => {
      if (audioPlaylist.paused) {
        audioPlaylist.play().catch(mostrarErrorPista);
        tituloCancionEl.textContent = cancionesKawaii[pistaActual].titulo;
        btnPlayPausa.textContent = "II";
      } else {
        audioPlaylist.pause();
        btnPlayPausa.textContent = ">";
      }
    };

    btnSigPista.onclick = () => reproducirPista(pistaActual + 1);

    audioPlaylist.addEventListener("timeupdate", actualizarBarraCorazon);
    audioPlaylist.addEventListener("loadedmetadata", actualizarBarraCorazon);
    audioPlaylist.onended = () => {
      if (pistaActual < cancionesKawaii.length - 1) {
        reproducirPista(pistaActual + 1);
      } else if (loopPlaylist) {
        reproducirPista(0);
      } else {
        btnPlayPausa.textContent = ">";
      }
    };

    barraProgresoEl.onclick = (e) => {
      if (!Number.isFinite(audioPlaylist.duration) || audioPlaylist.duration <= 0) return;
      const rect = barraProgresoEl.getBoundingClientRect();
      if (rect.width <= 0) return;
      const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      audioPlaylist.currentTime = ratio * audioPlaylist.duration;
      actualizarBarraCorazon();
    };

    pintarPlaylist();
