    function formatearTiempo(seg) {
      if (!Number.isFinite(seg) || seg < 0) return "0:00";
      const min = Math.floor(seg / 60);
      const s = Math.floor(seg % 60);
      return min + ":" + (s < 10 ? "0" : "") + s;
    }

    function actualizarBarraCorazon() {
      const dur = audioPlaylist.duration;
      const act = audioPlaylist.currentTime;
      if (Number.isFinite(dur) && dur > 0) {
        const pct = Math.min(100, Math.max(0, (act / dur) * 100));
        rellenoProgresoEl.style.width = pct + "%";
        corazonProgresoEl.style.left = pct + "%";
        tiempoActualEl.textContent = formatearTiempo(act);
        tiempoTotalEl.textContent = formatearTiempo(dur);
      } else {
        rellenoProgresoEl.style.width = "0%";
        corazonProgresoEl.style.left = "0%";
        tiempoActualEl.textContent = "0:00";
        tiempoTotalEl.textContent = "0:00";
      }
    }

    function pintarPlaylist() {
      listaCancionesEl.innerHTML = "";
      cancionesKawaii.forEach((pista, idx) => {
        const btn = document.createElement("button");
        btn.className = "item-cancion" + (idx === pistaActual ? " activa" : "");
        btn.textContent = (idx + 1) + ". " + pista.titulo + " - " + pista.artista;
        btn.title = btn.textContent;
        btn.onclick = () => reproducirPista(idx);
        listaCancionesEl.appendChild(btn);
